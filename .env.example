# ==============================================================================
# OBS Board - Variables de entorno
# ==============================================================================
# MODO LOCAL (por defecto):
# Si dejas las variables de Supabase vacías, la app funciona en modo local con
# persistencia en `.data/` y tiempo real vía SSE (listo para OBS en localhost).
#
# MODO NUBE (Supabase + Vercel):
# Pega estas 3 variables en Vercel -> Settings -> Environment Variables
# (NO en Supabase -> Edge Functions -> Secrets):

NEXT_PUBLIC_SUPABASE_URL=
# Tu "Publishable key" (sb_publishable_...) de Supabase -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Tu "Secret key" (sb_secret_...) de Supabase -> Project Settings -> API Keys
SUPABASE_SECRET_KEY=

# (También siguen siendo compatibles los nombres clásicos NEXT_PUBLIC_SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY)

# Secreto para firmar sesiones en modo local
APP_AUTH_SECRET=obs-board-local-dev-secret-change-me
