# ==============================================================================
# OBS Board - Variables de entorno
# ==============================================================================
# MODO LOCAL (por defecto):
# Si dejas las variables de Supabase vacías, la app funciona inmediatamente en
# modo local con almacenamiento persistente en `.data/`, cuentas locales y
# sincronización en tiempo real vía SSE (compatible directo con OBS en localhost).
#
# MODO NUBE (Supabase + Vercel):
# Crea un proyecto gratis en https://supabase.com, ejecuta `supabase/schema.sql`
# en el SQL Editor y pega tus claves aquí:

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: permite verificar tokens de OBS y sincronización server-side en modo nube
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar sesiones en modo local (cámbialo en producción)
APP_AUTH_SECRET=obs-board-local-dev-secret-change-me
